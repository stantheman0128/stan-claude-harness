{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/pythonw.exe",
            "args": [
              "-I",
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/hardstop_guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/pythonw.exe",
            "args": [
              "-I",
              "-X",
              "utf8",
              "${CLAUDE_PLUGIN_ROOT}/hooks/bypass_prompt.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
