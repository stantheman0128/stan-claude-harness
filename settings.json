{
  "cleanupPeriodDays": 3650,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_WORKFLOWS": "1",
    "PYTHONUTF8": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_SUBAGENT_EFFORT": "high"
  },
  "permissions": {
    "allow": [
      "WebFetch(*)",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Skill(*)",
      "mcp__claude-in-chrome",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_Read_AI",
      "mcp__claude_ai_Vercel",
      "mcp__claude_ai_Notion",
      "mcp__supabase",
      "mcp__plugin_claude-mem_mcp-search",
      "mcp__plugin_cloudflare_cloudflare-api",
      "mcp__plugin_cloudflare_cloudflare-bindings",
      "mcp__plugin_cloudflare_cloudflare-builds",
      "mcp__plugin_cloudflare_cloudflare-docs",
      "mcp__plugin_cloudflare_cloudflare-observability",
      "mcp__plugin_context7_context7",
      "mcp__plugin_playwright_playwright",
      "mcp__plugin_superpowers-chrome_chrome"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rmdir *)",
      "Bash(mv *)",
      "Bash(del *)",
      "Bash(shutdown *)",
      "Bash(format *)",
      "Bash(reboot *)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git rebase *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "adversarial-review": "off",
    "analyze-forks": "off",
    "codebase-design": "off",
    "context-compression": "off",
    "context-optimization": "off",
    "domain-modeling": "off",
    "grill-me": "off",
    "memory-systems": "off",
    "mistral-ocr-tts": "off",
    "report-verifier": "off",
    "setup-pre-commit": "off",
    "shadcn": "off",
    "to-issues": "off",
    "to-prd": "off",
    "triage": "off",
    "upstream-insights-report": "off",
    "video-lens-gallery": "off",
    "api:api-new": "off",
    "api:api-protect": "off",
    "api:api-test": "off",
    "industry-report": "off",
    "misc:code-cleanup": "off",
    "misc:code-explain": "off",
    "misc:code-optimize": "off",
    "misc:docs-generate": "off",
    "misc:feature-plan": "off",
    "misc:lint": "off",
    "new-task": "off",
    "reels": "off",
    "supabase:edge-function-new": "off",
    "supabase:types-gen": "off",
    "ui:component-new": "off",
    "ui:page-new": "off",
    "write-like-joyce": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/pythonw.exe",
            "args": [
              "-I",
              "C:/Users/stans/.claude/hooks/mode_guard.py"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:19280/"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/pythonw.exe",
            "args": [
              "C:/Users/stans/.claude/hooks/skill-routing-watch.py"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"C:/Users/stans/.claude/hooks/i-have-adhd-always.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/pythonw.exe",
            "args": [
              "-I",
              "C:/Users/stans/Projects/guardian/hooks/guardian-adopt.py",
              "claude",
              "--instance",
              "main",
              "--context"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:19280/"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/pythonw.exe",
            "args": [
              "C:/Users/stans/.claude/hooks/twify-session-name.py"
            ],
            "timeout": 15
          },
          {
            "type": "http",
            "url": "http://localhost:19280/"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/pythonw.exe",
            "args": [
              "C:/Users/stans/.claude/hooks/skill-usage-log.py"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/python.exe",
            "args": [
              "C:/Users/stans/.claude/hooks/harness-autosync.py"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/pythonw.exe",
            "args": [
              "C:/Users/stans/.claude/hooks/twify-session-name.py"
            ],
            "timeout": 15
          },
          {
            "type": "http",
            "url": "http://localhost:19280/"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/pythonw.exe",
            "args": [
              "C:/Users/stans/.claude/hooks/skill-suggest.py"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Python313/pythonw.exe",
            "args": [
              "-I",
              "C:/Users/stans/Projects/guardian/hooks/guardian-status.py",
              "claude",
              "--instance",
              "main"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:19280/"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:19280/"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://localhost:19280/"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash C:/Users/stans/.claude/statusline.sh",
    "padding": 1
  },
